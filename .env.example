NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/meta_ads_generator

# Admin auth (single-admin MVP)
ADMIN_EMAIL=metaadmin@tention.com
ADMIN_PASSWORD=change_this_password
SESSION_SECRET=replace_with_long_random_string

# AI Keys
OPENAI_API_KEY=your_openai_key_here

# Optional: override models (uncomment to change)
OPENAI_PROMPT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
